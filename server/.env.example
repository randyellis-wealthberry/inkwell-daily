# The Composio project key. This is the only secret in the service.
COMPOSIO_API_KEY=ak_your_project_key

# Default to production. Placeholder or short licenses are refused when this
# is set, so an example copied by mistake cannot become a working account.
NODE_ENV=production

# Licenses this service will answer for, comma separated. Generate one with
# `node scripts/new-license.mjs`. Never ship a real key in this file.
INKWELL_LICENSES=

# A JSON array of keys, re-read when it changes. Removing a key here revokes it
# on the next request without a restart. Point this at a file you can edit.
# INKWELL_LICENSE_FILE=./licenses.json

# Per-license budget: calls an hour, and desk calls open at once.
INKWELL_RATE_LIMIT=60
INKWELL_MAX_IN_FLIGHT=2

# Read-only OAuth grants. Create an auth config per toolkit in the dashboard
# with only read scopes, then put its id here. Without these, Composio's managed
# auth is used and the grant may be wider than the one tool we call.
# COMPOSIO_AUTH_CONFIG_GMAIL=ac_...
# COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=ac_...
# COMPOSIO_AUTH_CONFIG_SLACK=ac_...
# COMPOSIO_AUTH_CONFIG_NOTION=ac_...
# COMPOSIO_AUTH_CONFIG_BASECAMP=ac_...

# Refuse to create a session for any toolkit without a read-only auth config,
# rather than silently falling back to managed scopes. Turn this on for prod.
# INKWELL_REQUIRE_CUSTOM_AUTH=1

# Failed licenses allowed per address before a ten-minute block.
INKWELL_AUTH_FAILURES=20

# Signs the Connect links embedded in the integrations page. Required in
# production; without it a random secret is used and links break on restart.
INKWELL_SIGNING_SECRET=

# Absolute base for those links. Locally it is inferred from the request.
# INKWELL_PRO_PUBLIC_URL=https://desks.yourhost

# One JSON line per request: who read which desk, never a body. On by default.
# INKWELL_AUDIT=0
# INKWELL_AUDIT_FILE=/var/log/inkwell/audit.jsonl

# Set when a reverse proxy is in front, so limits key on the real client.
# INKWELL_TRUST_PROXY=1

# Where `session.authorize` sends the browser once the provider is done.
# Optional while developing; required before you show a Connect link to anyone.
# INKWELL_PRO_CALLBACK=https://your-host.example/connected

PORT=8787
